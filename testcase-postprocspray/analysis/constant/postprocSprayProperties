FoamFile
{
    version         2.0;
    format          ascii;

    root            "";
    case            "";
    instance        "";
    local           "";

    class           dictionary;
    object          ;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


DEM_ts              1.e-5; // s
DEM_dump_interval   1e3;    // DEM timesteps
dParticle           5.e-4; // m
scale               1;
minx -.015;
maxx  .015;
miny -.015;
maxy 0.015;
minz -0.001;
maxz 0.06;
dx 2.e-3;

cpAir 1004.; // [J/kg/K]
cpVapor 1860.;
dHLV 2500e3; //[J/kg]
lambdaAir 0.025; //[W/m/K]
minimumWaterMass 1.e-13;

solveTTransport false;
solveVapTransport false;

