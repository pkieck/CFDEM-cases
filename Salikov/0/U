FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 1 0);

boundaryField
{

    casing
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }

    inlet
    {
        type            fixedValue;
        value           uniform (0 25 0);
    }
    nozzle
    {
//        type            flowRateInletVelocity;
//        volumetricFlowRate .0014;
        type            surfaceNormalFixedValue;
        refValue        -17.33; // negative: INTO domain
        value           uniform (0 0 0);
    }

    outlet
    {
        type            zeroGradient;
    }
}

