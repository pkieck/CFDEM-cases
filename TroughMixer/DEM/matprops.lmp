variable dp equal 1e-2
variable rp equal ${dp}/2
variable rhop equal 2500

fix         m1 all property/global youngsModulus              peratomtype       1e-6
fix         m2 all property/global poissonsRatio              peratomtype       .2 
fix         m3 all property/global coefficientRestitution     peratomtypepair 1 .7
fix         m4 all property/global coefficientFriction        peratomtypepair 1 .2
fix         m5 all property/global coefficientRollingFriction peratomtypepair 1 .05

pair_style  gran model hertz tangential history rolling_friction cdt # history # Hertzian without cohesion
pair_coeff  * *
