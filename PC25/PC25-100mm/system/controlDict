FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     cfdemSolverPiso;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         13;

deltaT          5e-5;

writeControl    adjustableRunTime;

writeInterval   0.25;
/*
stopAt          endTime;

endTime         1e4;

deltaT          1;

writeControl    adjustableRunTime;

writeInterval   100;
*/
purgeWrite      2;

writeFormat     binary;

writePrecision  6;

writeCompression uncompressed;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  no;

maxCo 1;

//libs ( "libgroovyBC.so" "libfiniteVolumeCFDEM.so");

OptimizationSwitches { fileHandler collated; }

functions
{
#include "postProcessingDict"
}
