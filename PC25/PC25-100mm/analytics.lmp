shell mkdir logs
fix avx all ave/spatial 1 1 ${dts_avg} x center .01 density/number vx vy vz ave running file logs/av_x.csv  overwrite
fix avy all ave/spatial 1 1 ${dts_avg} y center .01 density/number vx vy vz ave running file logs/av_y.csv  overwrite
fix avz all ave/spatial 1 1 ${dts_avg} z center .01 density/number vx vy vz ave running file logs/av_z.csv  overwrite

fix avvx all ave/histo 1 1 ${dts_avg} -3 3 60 vx ave running mode vector file logs/vdist_x.csv overwrite
fix avvy all ave/histo 1 1 ${dts_avg} -3 3 60 vy ave running mode vector file logs/vdist_y.csv overwrite
fix avvz all ave/histo 1 1 ${dts_avg} -3 3 60 vz ave running mode vector file logs/vdist_z.csv overwrite
