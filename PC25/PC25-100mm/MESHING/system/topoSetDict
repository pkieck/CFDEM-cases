FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

actions
(
    {
        name    distributor;
        type    cellSet;
        action  new;
        source  boxToCell;
        sourceInfo
        {
            box (-.125 -.01 0.) (.125 0. .25);
        }
    }
    {
        name    distributor;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        sourceInfo
        {
            set distributor;
        }
    }

);

