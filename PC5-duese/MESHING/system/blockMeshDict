FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1;
//Bounding Box : (-0.125 -0.075 0) (0.125 0.607018 0.2)
xmin -0.130;
xmax  0.130;
ymin -0.110;
ymax  0.610;
zmin -0.001;
zmax   .210;
vertices
(
    ($xmin $ymin $zmin)
    ($xmax $ymin $zmin)
    ($xmax $ymax $zmin)
    ($xmin $ymax $zmin)
    ($xmin $ymin $zmax)
    ($xmax $ymin $zmax)
    ($xmax $ymax $zmax)
    ($xmin $ymax $zmax)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (22 52  20) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    A
    {
        type patch;
        faces
        (
            (3 7 6 2)
        );
    }
    B
    {
        type patch;
        faces
        (
            (1 5 4 0)
        );
    }
    C
    {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }
    D
    {
        type patch;
        faces
        (
            (2 6 5 1)
        );
    }
    E
    {
        type patch;
        faces
        (
            (0 3 2 1)
        );
    }
    F
    {
        type patch;
        faces
        (
            (4 5 6 7)
        );
    }
);

