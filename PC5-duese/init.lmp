variable 	dt equal 2e-6


echo            both

atom_style      granular
atom_modify     map array
communicate     single vel yes

boundary        f f f
newton          off
coarsegrain     4
units           si
#processors      2 3 2

region          reg block -0.126 0.126 -.11 1.001 -0.001 .201 units box
create_box      2 reg

include         matprops.lmp

neighbor        ${dp} bin
neigh_modify    delay 0


# timestep, gravity
timestep        ${dt}
fix             gravi all gravity 9.81 vector 0. -1. 0.

# walls
include         geometry.lmp
# particle distributions and insertion, large numbers are primes used for RNG startup
region          bc block -.125 .125 .2 .3 0. .2 units box
fix             pts1 all particletemplate/sphere 67867979                  &
                                                atom_type 1                &
                                                density constant ${rhop}   &
                                                radius  constant ${rp}
fix             pdd1 all particledistribution/discrete 15485863 1 pts1 1.0

fix             ins all insert/pack seed 86028157                          &
                                                 distributiontemplate pdd1 &
                                                 vel    constant 0. -.5 0. &
                                                 insert_every         once &
                                                 overlapcheck         yes  &
                                                 all_in               yes  &
                                                 mass_in_region       1.   &
                                                 region bc

# apply nve integration to all particles that are inserted as single particles
fix             integr all nve/sphere

# screen output
thermo_style    custom step atoms ke
thermo          5000
thermo_modify   lost ignore norm no

# insert the first particles so that dump is not empty
run         1
#dump        dmp all custom 5000 post/dump.liggghts_init id type x y z ix iy iz vx vy vz fx fy fz omegax omegay omegaz radius

#run         10000 upto
write_restart   dump/restart/restart.liggghts
