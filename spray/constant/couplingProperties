FoamFile
{
    version         2.0;
    format          ascii;

    root            "";
    case            "";
    instance        "";
    local           "";

    class           dictionary;
    object          couplingProperties;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//===========================================================================//
// sub-models & settings

modelType "B"; // A or B

couplingInterval 400; //200;

voidFractionModel centre;//

locateModel engine;

meshMotionModel noMeshMotion;

regionModel allRegion;

IOModel off;

probeModel particleProbe;

dataExchangeModel oneWayVTKmod;

averagingModel dense;//dilute;//

clockModel standardClock;//off;

smoothingModel off;// localPSizeDiffSmoothing;// constDiffSmoothing; //

forceModels
(
  noDrag
);

momCoupleModels
(
  off
);

turbulenceModelType turbulenceProperties;

//===========================================================================//
// sub-model properties

oneWayVTKmodProps
{
  relativePath         "../dump";
  maxNumberOfParticles 100000;
  DEMts                2.5e-7;
  couplingFilename     "dump.%i.vtk";
}


particleProbeProps
{
  verboseToFile;
  printEvery       500; //every .05 s
  particleIDsToSample (0 0);
  sampleAll;
  probeDebug;
  writePrecision 4;   //number of significant digits to print

}

volWeightedAverageProps
{
    scalarFieldNames
    (
        voidfraction
    );
    vectorFieldNames
    (
    );
    upperThreshold 0.999;
    lowerThreshold 0;
    verbose true;
}

noDragProps {}

particleCellVolumeProps
{
    upperThreshold 0.999;
    lowerThreshold 0.;
    verbose true;
}

fieldVolWeightedProps
{
    startTime 0;

    scalarFieldNames
    (
    );

    vectorFieldNames
    (
        "U"
    );
    useVolumeFraction true;
    volumeFractionName "voidfraction";
}

engineProps
{
    treeSearch true;
}

centreProps
{
    alphaMin 0.36;
    scaleUpVol 1.0;
}

dividedProps
{
    alphaMin 0.36;
    scaleUpVol 1.0;
}
