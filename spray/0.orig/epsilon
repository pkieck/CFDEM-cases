FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];
#include        "../BCDict"
internalField   uniform $epsilon;

boundaryField
{
    casing
    {
        type            epsilonWallFunction;
        value           uniform $epsilon;
    }
    inlet
    {
        type            fixedValue;
        value           uniform $epsilon;
    }
    nozzle
    {
        type            fixedValue;
        value           uniform $epsilon_nozzle;
    }

    outlet
    {
        type            zeroGradient;
    }
}


