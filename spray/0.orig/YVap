FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      YVap;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform .008;

boundaryField
{
    inlet           
    {
        type            fixedValue;
        value           uniform .008;
    }

    nozzle           
    {
        type            fixedValue;
        value           uniform .005;
    }
   
    outlet          
    {
        type            zeroGradient;
    }

    casing       
    {
        type            zeroGradient;
    }
}

